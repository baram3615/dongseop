if barstate.isfirst
    tradeCount = array.size(entryTimes)

    for i = 0 to tradeCount - 1
        et = array.get(entryTimes, i)
        xt = array.get(exitTimes, i)
        ep = array.get(entryPrices, i)
        xp = array.get(exitPrices, i)
        d = array.get(directions, i)
        pnl = array.get(pnls, i)

        isLong = d == 1
        dirColor = isLong ? color.rgb(22, 119, 255) : color.rgb(255, 122, 0)
        pnlColor = pnl >= 0 ? color.rgb(0, 166, 81) : color.rgb(220, 53, 69)

        // 1) 진입/청산 위치 마커 (FILL 화살표와 구분되도록 라벨 도형 사용)
        entryText = isLong ? "LONG ENTRY" : "SHORT ENTRY"
        exitText = isLong ? "LONG EXIT" : "SHORT EXIT"
        entryStyle = label.style_label_left
        exitStyle = label.style_label_right
        label.new(et, ep, entryText, xloc=xloc.bar_time, style=entryStyle, color=dirColor, textcolor=chart.fg_color, size=size.tiny)
        label.new(xt, xp, exitText, xloc=xloc.bar_time, style=exitStyle, color=color.new(dirColor, 15), textcolor=chart.fg_color, size=size.tiny)

        // 2) 포지션 유지 구간(시간+가격 변동)
        line.new(et, ep, xt, xp, xloc=xloc.bar_time, color=dirColor, width=2)
        topP = math.max(ep, xp)
        botP = math.min(ep, xp)
        box.new(et, topP, xt, botP, xloc=xloc.bar_time, border_color=color.new(dirColor, 40), bgcolor=color.new(pnlColor, 86))

        // 3) 손익 표시 라벨
        mt = int(math.floor((et + xt) / 2))
        mp = (ep + xp) / 2.0
        sideText = isLong ? "LONG" : "SHORT"
        pnlText = "PnL(BTC): " + str.tostring(pnl, format.mintick)
        label.new(mt, mp, sideText + "\n" + pnlText, xloc=xloc.bar_time, style=label.style_label_center, color=color.new(pnlColor, 0), textcolor=chart.fg_color, size=size.small)

    // 4) Trading history 체결 마커 (leavesQty == 0 필터된 데이터)
    fillCount = array.size(fillTimes)
    for j = 0 to fillCount - 1
        ft = array.get(fillTimes, j)
        fp = array.get(fillPrices, j)
        fs = array.get(fillSides, j)
        fq = array.get(fillOrderQtys, j)

        isBuyFill = fs == 1
        fillColor = isBuyFill ? color.rgb(0, 163, 108) : color.rgb(230, 57, 70)
        fillText = isBuyFill ? "FILL BUY" : "FILL SELL"
        qtyText = "QTY: " + str.tostring(fq, format.mintick)
        fillStyle = isBuyFill ? label.style_triangleup : label.style_triangledown

        label.new(ft, fp, fillText + "\n" + qtyText, xloc=xloc.bar_time, style=fillStyle, color=fillColor, textcolor=chart.fg_color, size=size.tiny)
